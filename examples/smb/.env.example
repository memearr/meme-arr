# Copy to .env and fill in. Portainer / docker compose reads these.
#
# NOTE: Plex URL, token, and path mappings are now configured IN THE APP on the
# Settings page — you do NOT need to put them here. The only required values are
# the SMB credentials used to mount your Windows shares.

# --- SMB / Windows shares (required for the CIFS mounts in docker-compose.yml) ---
SMB_HOST=192.168.1.20          # host serving the Windows shares (or set per-share in compose)
SMB_USER=plexmedia
SMB_PASS=changeme

# --- Optional first-run Plex bootstrap (otherwise configure in the UI) ---
# PLEX_URL=http://192.168.1.10:32400
# PLEX_TOKEN=xxxxxxxxxxxxxxxxxxxx
# PATH_MAP=/volume1/media=>/media/drive1

# --- Optional: enable the sidebar "check for updates" against GitHub ---
# The public repo needs no token. Only a private fork of it does: a read-only
# token (classic PAT with `repo` scope, or fine-grained with Contents:read).
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxx
# GITHUB_REPO=memearr/meme-arr
